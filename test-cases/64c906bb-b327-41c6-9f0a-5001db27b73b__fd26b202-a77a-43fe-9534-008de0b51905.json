{
  "id": "fd26b202-a77a-43fe-9534-008de0b51905",
  "testPlanId": "64c906bb-b327-41c6-9f0a-5001db27b73b",
  "requirementId": "1d83d26d-5669-47c4-94f5-ad2682e22bc0",
  "suiteName": "Lead Management - Create Lead (SMOKE)",
  "case": {
    "id": "fd26b202-a77a-43fe-9534-008de0b51905",
    "title": "Create Lead with mandatory fields and verify default status and redirect",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Salesforce environment URL",
        "value": "https://orgfarm-cdb7bbd1fc-dev-ed.develop.my.salesforce.com"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Login as Sales Representative",
        "screenName": "SalesforceLoginPage",
        "pageObjectMethod": "loginAsRole",
        "value": "admin"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Go to Leads tab",
        "locatorHint": "a[title='Leads']",
        "screenName": "Home",
        "pageObjectMethod": "clickLeads"
      },
      {
        "id": "s4",
        "action": "waitForVisible",
        "targetDescription": "Wait for New button on Leads list view",
        "locatorHint": "button[name='New']",
        "screenName": "Home",
        "pageObjectMethod": "expectLeadsVisible",
        "value": "10000"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Click New to open Lead creation modal",
        "locatorHint": "button[name='New']"
      },
      {
        "id": "s7",
        "action": "fill",
        "targetDescription": "Enter Last Name (required)",
        "locatorHint": "input[name='lastName']",
        "screenName": "LeadNew",
        "pageObjectMethod": "fillLastName",
        "value": "Smith"
      },
      {
        "id": "s8",
        "action": "fill",
        "targetDescription": "Enter Company (required)",
        "locatorHint": "input[name='Company']",
        "screenName": "LeadNew",
        "pageObjectMethod": "fillCompany",
        "value": "ABC Technologies"
      },
      {
        "id": "s9",
        "action": "tap",
        "targetDescription": "Save new Lead",
        "locatorHint": "button[name='SaveEdit']",
        "screenName": "LeadNew",
        "pageObjectMethod": "clickSaveAndNew"
      },
      {
        "id": "s10",
        "action": "waitForVisible",
        "targetDescription": "Wait for Lead record page to load",
        "locatorHint": "h1",
        "value": "15000"
      },
      {
        "id": "s11",
        "action": "assertContainsText",
        "targetDescription": "Verify redirected to Lead record page (header shows Last Name)",
        "locatorHint": "h1",
        "assertion": "Smith"
      },
      {
        "id": "s12",
        "action": "assertContainsText",
        "targetDescription": "Verify default Lead Status is Open - Not Contacted",
        "locatorHint": "body",
        "assertion": "Open - Not Contacted"
      }
    ],
    "tags": [
      "@smoke",
      "@regression"
    ]
  }
}
